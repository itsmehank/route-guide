# NAVER Cloud Platform > Services > AI·Application Service > Maps 에서 발급
# 콘솔의 Application 등록 시 "서비스 환경 > Web 서비스 URL"에
# http://localhost:3000 을 반드시 등록해야 Dynamic Map(Web JS) 인증이 통과한다.
NCP_MAPS_CLIENT_ID=your_client_id_here
NCP_MAPS_CLIENT_SECRET=your_client_secret_here

# (선택) API 호스트 override. 기본값은 maps.apigw.ntruss.com.
# 구 호스트 naveropenapi.apigw.ntruss.com 은 신규 키에 401 Permission Denied 를 반환한다.
# NCP_MAPS_API_HOST=https://maps.apigw.ntruss.com

# NCP 콘솔 > NAVER API HUB 에서 Application 등록 후 '지역 검색' 선택 시 발급
# Maps 키와 별개의 값이다. 일 25,000건 / 월 775,000건 무료.
NAVER_HUB_CLIENT_ID=your_hub_client_id_here
NAVER_HUB_CLIENT_SECRET=your_hub_client_secret_here
