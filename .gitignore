# =====================================================================
# 비밀값 — 절대 커밋 금지
# =====================================================================
# 실제 API 키(.env). 예시 파일(.env.example, 값은 your_... 자리표시)만 올린다.
.env
.env.*
!.env.example
*.pem
*.key

# =====================================================================
# 개인정보가 찍힌 이미지 — 브라우저 즐겨찾기 바·프로필 사진·
# 네이버 지도 '최근 검색/저장한 경로/자주 가는 곳', 실제 이동 경로가 보인다
# =====================================================================
# 루트에 둔 임시 스크린샷 (교통량.png, 확대전.png …)
/*.png
/*.jpg
/*.jpeg
# 네이버 지도 화면 참고 캡처 (개인 검색 기록 포함)
docs/ref/
# 직접 찍은 버그 캡처 (실제 출발·도착 장소명 + 브라우저 UI)
route-guide-screenshots-v2/상세 경로 클릭 이상.png
route-guide-screenshots-v2/유턴이상.png
# 브리핑 '저장'으로 내려받은 파일 (네이버 로드뷰 사진 포함 — 개인 확인용, 재배포 금지)
브리핑_*.html

# =====================================================================
# 실행 산출물 · 캐시 (원본 API 응답, 지도·로드뷰 이미지, 생성 HTML, 백업)
# =====================================================================
out/

# 공공데이터 원본 (대용량, 재다운로드 가능)
data/

# =====================================================================
# 개발 환경
# =====================================================================
# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# OS · 에디터
.DS_Store
**/.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Claude Code 로컬 설정 (개인 권한·경로)
.claude/settings.local.json

# 로그
*.log
